      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  UPDATE etl_runs SET status = 'error', finished_at = now(), error = $3 || ': ' || $4\n  WHERE run_id = $1 AND status = 'running'\n  RETURNING for_date\n)\nSELECT $1 AS run_id, $2 AS workflow, $3 AS node, $4 AS error, $5 AS url,\n       (SELECT for_date::text FROM u) AS for_date",
        "options": {
          "queryReplacement": "={{ [ String($json.execution.id ?? ''), $json.workflow.name, $json.execution.lastNodeExecuted || '?', $json.execution.error.message, $json.execution.url || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pgIRuler00000001",
          "name": "Postgres (iRuler)"
        }
      }
    },
    {
