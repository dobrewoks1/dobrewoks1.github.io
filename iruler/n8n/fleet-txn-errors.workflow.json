      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.ALERT_CHAT_ID }}",
        "text": "={{ '🔴 ' + $json.workflow + '\\nУзел: ' + $json.node + '\\n' + $json.error\n  + '\\nДата: ' + ($json.for_date || '—')\n  + '\\nПерезапуск: GET /webhook/fleet-txn-rerun?date=' + ($json.for_date || 'ГГГГ-ММ-ДД')\n  + '\\n' + $json.url }}",
        "additionalFields": {
